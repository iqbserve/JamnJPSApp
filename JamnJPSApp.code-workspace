{
	"folders": [
		{
			"path": "./"
		}
	],
	"launch": {
		"configurations": [
			{
				"type": "java",
				"name": "JPSApp in workspace",
				"request": "launch",
				"console": "internalConsole",
				"cwd": "./server-app/app",
				"mainClass": "iqb.jps.boot.ApplicationLauncher",
				"projectName": "jamn-JPSApp",
				"vmArgs": ""
			},
			{
				"type": "java",
				"name": "CLI App in workspace",
				"request": "launch",
				"console": "integratedTerminal",
				"cwd": "${workspaceFolder}/server-app/app",
				"mainClass": "iqb.jps.boot.ApplicationLauncher",
				"projectName": "jamn-JPSApp",
				"args": "app=cli cli.port=9091",
				"vmArgs": ""
			},
			{
				"type": "java",
				"name": "JPSApp from JAR",
				"request": "launch",
				"cwd": "${workspaceFolder}/server-app/app",
				"mainClass": "iqb.jps.boot.ApplicationLauncher",
				"projectName": "jamn-JPSApp",
				"classPaths": [
					"${workspaceFolder}/server-app/app/target/jamn-JPSApp-0.0.1-SNAPSHOT.jar"
				],
				"args": "",
				"vmArgs": ""
			}
		]
	},
	"settings": {
		"java.configuration.updateBuildConfiguration": "automatic",
		"java.debug.settings.forceBuildBeforeLaunch": false,
		"java.import.exclusions": [
			"**/server-app/app/workspace/**"
		],
		"maven.excludedFolders": [
			"**/server-app/app/workspace/**"
		],
		"maven.view": "hierarchical",
		"files.exclude": {
			"**/server-app/app/workspace": true
		},
		"search.exclude": {
			"**/server-app/app/workspace/**": true
		},
		"files.watcherExclude": {
			"**/server-app/app/workspace/**": true
		},
		"maven.terminal.favorites": [
			{
				"alias": "Clean-install",
				"command": "clean install"
			}
		],
		"js/ts.validate.enabled": true,
		"java.jdt.ls.vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xmx8G -Xms100m -Xlog:disable"
	}
}