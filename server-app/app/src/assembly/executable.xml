<assembly xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3 http://maven.apache.org/xsd/assembly-1.1.3.xsd">
    <id>executable</id>
    <formats>
        <format>jar</format>
    </formats>
    <baseDirectory>/</baseDirectory>

    <fileSets>
        <fileSet>
            <directory>${project.build.outputDirectory}</directory>
            <outputDirectory>/</outputDirectory>
            <includes>
                <include>**/*</include>
            </includes>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/http</directory>
            <outputDirectory>/http</outputDirectory>
            <useDefaultExcludes>false</useDefaultExcludes>
            <includes>
                <include>${jps.web.resources}</include>
            </includes>
        </fileSet>
    </fileSets>

    <dependencySets>
        <dependencySet>
            <outputDirectory>/</outputDirectory>
            <useProjectArtifact>false</useProjectArtifact>
            <scope>runtime</scope>
            <unpack>true</unpack>
            <includes>
                <include>iqb.jps:jpsapp-boot</include>
            </includes>
        </dependencySet>

        <dependencySet>
            <outputDirectory>${jps.executable.libs.dir}</outputDirectory>
            <useProjectArtifact>false</useProjectArtifact>
            <scope>runtime</scope>
            <unpack>false</unpack>
            <useTransitiveDependencies>true</useTransitiveDependencies>
            <includes>
                <include>org.slf4j:slf4j-api</include>
                <include>org.slf4j:slf4j-jdk14</include>
                <include>com.fasterxml.jackson.core:jackson-annotations</include>
                <include>tools.jackson.core:jackson-databind</include>
                <include>tools.jackson.core:jackson-core</include>
                <include>iqb.jps:jpsapp-core</include>
                <include>iqb.jps:jamn-server</include>
            </includes>
        </dependencySet>
    </dependencySets>
</assembly>