<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>iqb.jps</groupId>
        <artifactId>jaman-jpsapp-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <groupId>iqb.jps</groupId>
    <artifactId>jamn-JPSApp</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>JPSApp Executable Jar</name>
    <description>Executable application jar that packages all modules.</description>

    <dependencies>
        <dependency>
            <groupId>iqb.jps</groupId>
            <artifactId>jpsapp-boot</artifactId>
        </dependency>
        <dependency>
            <groupId>iqb.jps</groupId>
            <artifactId>jpsapp-core</artifactId>
        </dependency>
        <dependency>
            <groupId>iqb.jps</groupId>
            <artifactId>jamn-server</artifactId>
        </dependency>
        <!-- GraalVM Polyglot API -->
        <dependency>
            <groupId>org.graalvm.polyglot</groupId>
            <artifactId>polyglot</artifactId>
        </dependency>
        <!-- GraalVM JavaScript Engine (Community Edition) -->
        <dependency>
            <groupId>org.graalvm.polyglot</groupId>
            <artifactId>js-community</artifactId>
            <type>pom</type>
        </dependency>
        <dependency>
            <groupId>iqb.jps</groupId>
            <artifactId>jaman-jpswebapp</artifactId>
        </dependency>
        <!-- provided: keeps jpsapp-cli off the runtime/assembly classpath but puts its classes
             on the IDE/reactor compile classpath so the Launcher can resolve CliApp in IDE mode -->
        <dependency>
            <groupId>iqb.jps</groupId>
            <artifactId>jpsapp-cli</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>${java.version}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-jar</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <!-- jpsapp-cli is now a provided dependency (IDE classpath only) and is therefore
                         excluded from the runtime dependencySets in the assembly descriptors; copy it out
                         explicitly here with a fixed name, giving the Launcher a guaranteed cli jar file name -->
                    <execution>
                        <id>copy-cli-jar</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>iqb.jps</groupId>
                                    <artifactId>jpsapp-cli</artifactId>
                                    <version>${project.version}</version>
                                    <type>jar</type>
                                    <destFileName>${jps.cli.jar.name}</destFileName>
                                    <outputDirectory>${project.build.directory}/cli-libs</outputDirectory>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <configuration>
                    <descriptors>
                        <descriptor>${assembly.descriptor}</descriptor>
                    </descriptors>
                    <finalName>${project.artifactId}-${project.version}</finalName>
                    <appendAssemblyId>false</appendAssemblyId>
                    <archive>
                        <manifest>
                            <mainClass>${jps.launcher.class}</mainClass>
                        </manifest>
                    </archive>
                </configuration>
                <executions>
                    <execution>
                        <id>make-executable-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>

        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>

    <profiles>
        <!-- m2e's incremental workspace build cannot copy a reactor sibling's jar before it is
             physically packaged (MDEP-187); real "mvn package" reactor builds are unaffected since
             cli-app is always packaged before app runs. Only silences the IDE-only build error. -->
        <profile>
            <id>m2e-lifecycle-mapping</id>
            <activation>
                <property>
                    <name>m2e.version</name>
                </property>
            </activation>
            <build>
                <pluginManagement>
                    <plugins>
                        <plugin>
                            <groupId>org.eclipse.m2e</groupId>
                            <artifactId>lifecycle-mapping</artifactId>
                            <version>1.0.0</version>
                            <configuration>
                                <lifecycleMappingMetadata>
                                    <pluginExecutions>
                                        <pluginExecution>
                                            <pluginExecutionFilter>
                                                <groupId>org.apache.maven.plugins</groupId>
                                                <artifactId>maven-dependency-plugin</artifactId>
                                                <versionRange>[3.0.0,)</versionRange>
                                                <goals>
                                                    <goal>copy</goal>
                                                </goals>
                                            </pluginExecutionFilter>
                                            <action>
                                                <ignore />
                                            </action>
                                        </pluginExecution>
                                    </pluginExecutions>
                                </lifecycleMappingMetadata>
                            </configuration>
                        </plugin>
                    </plugins>
                </pluginManagement>
            </build>
        </profile>
    </profiles>
</project>