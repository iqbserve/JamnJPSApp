<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>iqb.jps</groupId>
		<artifactId>jaman-jpsapp-project-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<groupId>iqb.jps</groupId>
	<artifactId>jaman-jpsapp-parent</artifactId>
	<packaging>pom</packaging>
	<version>0.0.1-SNAPSHOT</version>

	<name>JPSApp Server Project</name>
	<description>${jps.app.description}</description>
	<url>${project.url}</url>
	
	<properties>
		<jps.app.name>Jamn JPSApp</jps.app.name>
		<project.url>https://github.com/iqbserve/JamnJPSApp</project.url>
		<jps.app.description><![CDATA[Jamn Personal Server app project. The JPSApp is a Java-SE based, experimental scaffold for building individual All-in-One apps and tools using an also JSE based http capeable micro Server.]]></jps.app.description>
		<jps.app.version>${project.version}</jps.app.version>
		<jps.launcher.class>iqb.jps.boot.ApplicationLauncher</jps.launcher.class>
		<jps.app.class>iqb.jps.JPSApp</jps.app.class>
		<jps.executable.libs.dir>modules</jps.executable.libs.dir>
		<jps.executable.temp.dir.prefix>jpsapp-modules-</jps.executable.temp.dir.prefix>

		<author>Andreas Weidinger - IQB Services</author>
		<authorUrl>https://iqbserve.de/</authorUrl>

		<maven.build.timestamp.format>dd-MM-yyyy HH:mm:ss</maven.build.timestamp.format>
		<build.timestamp>${maven.build.timestamp}</build.timestamp>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

		<!-- 
			Default assembly with JavaScript
			use: -Pnojs to build without JavaScript
			the <jps.javascript.enabled> property is also switched and exported to the application
		-->
		<assembly.descriptor>src/assembly/executable-js.xml</assembly.descriptor>
		<jps.javascript.enabled>true</jps.javascript.enabled>

		<!-- **/* to include all from /http-->
		<jps.web.resources>**/*</jps.web.resources>
	</properties>

	<profiles>
		<profile>
			<id>nojs</id>
			<properties>
				<assembly.descriptor>src/assembly/executable.xml</assembly.descriptor>
				<jps.javascript.enabled>false</jps.javascript.enabled>
			</properties>
		</profile>
	</profiles>

	<modules>
		<module>boot</module>
		<module>core</module>
		<module>jamn-server</module>
		<module>app</module>
		<module>../web-app</module>
	</modules>

</project>