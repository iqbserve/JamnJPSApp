{
    "compilerOptions": {
        "target": "ES2022",
        "module": "esnext",
        "moduleResolution": "bundler",
        "allowJs": true,
        "checkJs": false,
        "outDir": "../server-app/app/http",
        "rootDir": "./src",
        "paths": {
            "app/*": [
                "./src/app/*"
            ],
            "config/*": [
                "./src/config/*"
            ],
            "core/*": [
                "./src/app/core/*"
            ],
            "features/*": [
                "./src/app/features/*"
            ],
            "types/*": [
                "./src/types/*"
            ]
        }
    },
    "include": [
        "src/app/**/*",
        "src/types/**/*"
    ]
}